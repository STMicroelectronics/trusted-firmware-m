# This CMake script template contains the set of stm32cube options settled on
# secure side build but necessary for building the non-secure side too.

set(STM32CUBE_MP2_PATH          @STM32CUBE_MP2_PATH@              CACHE PATH      "Path to stm32cubemp2 package (or DOWNLOAD to fetch automatically)")
set(STM32CUBE_MP2_GIT_REMOTE    @STM32CUBE_MP2_GIT_REMOTE@        CACHE STRING    "URL (or path) to retrieve stm32cubemp2 package")
set(STM32CUBE_MP2_VERSION       @STM32CUBE_MP2_VERSION@           CACHE STRING    "version of stm32cubemp2 package")
